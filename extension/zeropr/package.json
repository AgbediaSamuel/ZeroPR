{
  "name": "zeropr",
  "displayName": "zeropr",
  "description": "Reinventing developer collaboration",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:zeropr.getPeers"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zeropr.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "zeropr.startBroadcast",
        "title": "Start Search" 
      },
      {
        "command": "zeropr.stopBroadcast",
        "title": "Stop Search"
      },
      {
        "command": "zeropr.createSession",
        "title": "Create Session"
      },
      {
        "command": "zeropr.joinSession",
        "title": "Join Session",
        "icon": "$(play)"
      },
      {
        "command": "zeropr.leaveSession",
        "title": "Leave Session",
        "icon": "$(close)"
      },
      {
        "command": "zeropr.endSession",
        "title": "End Session",
        "icon": "$(close)"
      },
      {
        "command": "zeropr.invitePeer",
        "title": "Invite to Session",
        "icon": "$(add)"
      },
      {
        "command": "zeropr.refreshPeers",
        "title": "Refresh Peers",
        "icon": "$(refresh)"
      },
      {
        "command": "zeropr.refreshSessions",
        "title": "Refresh Sessions",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zeropr.startBroadcast",
          "when": "view == zeropr.getPeers",
          "group": "navigation"
        },
        {
          "command": "zeropr.stopBroadcast",
          "when": "view == zeropr.getPeers",
          "group": "navigation"
        },
        {
          "command": "zeropr.refreshPeers",
          "when": "view == zeropr.getPeers",
          "group": "navigation"
        },
        {
          "command": "zeropr.refreshSessions",
          "when": "view == zeropr.sessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "zeropr.invitePeer",
          "when": "view == zeropr.getPeers",
          "group": "inline"
        },
        {
          "command": "zeropr.joinSession",
          "when": "view == zeropr.sessions && viewItem == invitation",
          "group": "inline"
        },
        {
          "command": "zeropr.endSession",
          "when": "view == zeropr.sessions && viewItem == ownSession",
          "group": "inline"
        },
        {
          "command": "zeropr.leaveSession",
          "when": "view == zeropr.sessions && viewItem == invitation",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zeropr",
          "title": "ZeroPR",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "zeropr": [
        {
          "id": "zeropr.getPeers",
          "name": "Peers"
        },
        {
          "id": "zeropr.sessions",
          "name": "Sessions"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "yjs": "^13.6.0",
    "y-protocols": "^1.0.6",
    "lib0": "^0.2.88"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
